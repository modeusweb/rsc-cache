{
  "name": "rsc-cache",
  "version": "0.2.0",
  "description": "Persistent, tag-invalidated caching layer for React Server Components. Framework-agnostic, TypeScript-first, zero runtime dependencies.",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "server-components",
    "cache",
    "caching",
    "react-cache",
    "server-cache",
    "distributed-cache",
    "stale-while-revalidate",
    "nextjs",
    "edge"
  ],
  "license": "MIT",
  "author": "modeusweb <modeusweb@gmail.com> (https://github.com/modeusweb)",
  "homepage": "https://github.com/modeusweb/rsc-cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeusweb/rsc-cache.git"
  },
  "bugs": {
    "url": "https://github.com/modeusweb/rsc-cache/issues"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory.d.ts",
      "default": "./dist/memory.js"
    },
    "./redis": {
      "types": "./dist/redis.d.ts",
      "default": "./dist/redis.js"
    },
    "./kv": {
      "types": "./dist/kv.d.ts",
      "default": "./dist/kv.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./opentelemetry": {
      "types": "./dist/opentelemetry.d.ts",
      "default": "./dist/opentelemetry.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rsc-cache": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src tests benchmarks",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "bench": "npx -y tsx benchmarks/bench.ts",
    "check:exports": "publint",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run verify",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && publint"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.83.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
